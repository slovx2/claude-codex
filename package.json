{
  "name": "codex-harness-adapter",
  "version": "0.2.0",
  "private": true,
  "description": "在 Codex 桌面端连接各种 harness",
  "license": "MIT",
  "homepage": "https://github.com/slovx2/codex-harness-adapter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slovx2/codex-harness-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/slovx2/codex-harness-adapter/issues"
  },
  "type": "module",
  "bin": {
    "codex-harness-adapter": "scripts/run-cli.mjs"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "dev": "tsx packages/claude/src/adapter.mts",
    "build": "npm run build --prefix packages/claude && npm run build --prefix packages/pi && node scripts/build-cli.mjs",
    "typecheck": "npm run typecheck --prefix packages/claude && npm run typecheck --prefix packages/pi",
    "lint": "biome lint packages scripts",
    "format": "biome format --write packages scripts",
    "check": "biome check packages scripts",
    "check:fix": "biome check --write packages scripts",
    "check:rust-protocol-fixtures": "node scripts/check-rust-protocol-fixtures.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "npm run test --prefix packages/claude && npm run test --prefix packages/pi && go test ./...",
    "doctor": "node scripts/run-cli.mjs doctor",
    "workflow": "npm run build && node packages/claude/dist/claude/src/workflow-cli.mjs",
    "workflow:schedule": "npm run workflow -- schedule",
    "smoke:real": "npm run build && node scripts/smoke-real-claude.mjs",
    "probe:capabilities": "npm run build && node scripts/probe-capabilities.mjs",
    "acceptance:local-remote": "npm run build && node scripts/acceptance-local-remote.mjs",
    "acceptance:gui-ssh-localhost": "npm run build && node scripts/acceptance-gui-ssh-localhost.mjs",
    "acceptance:ssh-runtime-matrix": "npm run build && node scripts/acceptance-ssh-runtime-matrix.mjs",
    "probe:codex-cli-remote": "npm run build && node scripts/probe-codex-cli-remote.mjs",
    "start": "node scripts/run-cli.mjs serve",
    "generate:schema": "codex app-server generate-ts --experimental --out generated/codex-app-server",
    "test:protocol": "npm run build && node scripts/test-protocol.mjs",
    "test:local-ssh": "node scripts/test-local-ssh.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": "24.14.0"
  }
}
